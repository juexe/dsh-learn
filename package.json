{
  "name": "dsh-learn",
  "version": "0.1.0",
  "private": true,
  "description": "Static analysis and interactive visualization of the DeepSeek Harness package dependency graph and its model-facing registration surfaces",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.19"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Juexe/dsh-learn.git"
  },
  "homepage": "https://github.com/Juexe/dsh-learn#readme",
  "bugs": {
    "url": "https://github.com/Juexe/dsh-learn/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dependency-graph",
    "static-analysis",
    "visualization"
  ],
  "scripts": {
    "build": "node scripts/extract.mjs && node scripts/analyze.mjs && node scripts/scan-registrations.mjs && node scripts/build-page.mjs",
    "extract": "node scripts/extract.mjs",
    "analyze": "node scripts/analyze.mjs",
    "scan": "node scripts/scan-registrations.mjs",
    "page": "node scripts/build-page.mjs",
    "verify": "node scripts/verify-page.mjs",
    "crosscheck": "node scripts/crosscheck-tools.mjs",
    "check": "node scripts/verify-page.mjs && node scripts/crosscheck-tools.mjs",
    "serve": "node scripts/serve.mjs"
  }
}
